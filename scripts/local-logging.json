{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "local": {
      "format": "%(asctime)s %(levelname)s %(name)s %(message)s",
      "datefmt": "%Y-%m-%dT%H:%M:%S%z"
    }
  },
  "handlers": {
    "local": {
      "class": "logging.StreamHandler",
      "formatter": "local",
      "stream": "ext://sys.stderr"
    }
  },
  "root": {
    "handlers": [
      "local"
    ],
    "level": "WARNING"
  },
  "loggers": {
    "uvicorn": {
      "handlers": [
        "local"
      ],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "level": "INFO"
    }
  }
}
